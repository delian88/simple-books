generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(uuid()) @db.VarChar(36)
  email              String    @unique @db.VarChar(255)
  password           String    @db.VarChar(255)
  role               String    @default("Company") @db.VarChar(50) // "Admin" or "Company"
  subscriptionStatus String?   @map("subscription_status") @db.VarChar(50) // "TRIAL", "ACTIVE", "EXPIRED"
  trialEndsAt        DateTime? @map("trial_ends_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  profile        Profile?
  companyMembers CompanyUser[]
  transactions   Transaction[]
  balanceItems   BalanceItem[]
  activityLogs   ActivityLog[]

  @@map("users")
}

model Profile {
  id           String   @id @db.VarChar(36)
  businessName String   @default("My Business") @map("business_name") @db.VarChar(255)
  currency     String   @default("NGN") @db.VarChar(10)
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [id], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Company {
  id                   String   @id @default(uuid()) @db.VarChar(36)
  name                 String   @db.VarChar(255)
  taxId                String?  @map("tax_id") @db.VarChar(100)
  defaultCurrency      String   @default("NGN") @map("default_currency") @db.VarChar(10)
  defaultLanguage      String   @default("en") @map("default_language") @db.VarChar(10)
  fiscalYearStartMonth Int      @default(1) @map("fiscal_year_start_month")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  members            CompanyUser[]
  branches           Branch[]
  transactions       Transaction[]
  balanceItems       BalanceItem[]
  activityLogs       ActivityLog[]
  accounts           Account[]
  journalEntries     JournalEntry[]
  journalTemplates   JournalTemplate[]
  recurringSchedules RecurringSchedule[]
  customers          Customer[]
  salesInvoices      SalesInvoice[]
  customerPayments   CustomerPayment[]
  creditNotes        CreditNote[]

  @@map("companies")
}

model CompanyUser {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String   @map("user_id") @db.VarChar(36)
  companyId String   @map("company_id") @db.VarChar(36)
  role      String   @default("VIEWER") @db.VarChar(50) // "OWNER", "ADMIN", "MANAGER", "VIEWER"
  status    String   @default("ACTIVE") @db.VarChar(50) // "ACTIVE", "INVITED", "DISABLED"
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
  @@map("company_users")
}

model Branch {
  id        String   @id @default(uuid()) @db.VarChar(36)
  companyId String   @map("company_id") @db.VarChar(36)
  name      String   @db.VarChar(255)
  address   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([companyId])
  @@map("branches")
}

model Transaction {
  id           String   @id @default(uuid()) @db.VarChar(36)
  userId       String?  @map("user_id") @db.VarChar(36)
  companyId    String?  @map("company_id") @db.VarChar(36)
  branchId     String?  @map("branch_id") @db.VarChar(36)
  createdBy    String?  @map("created_by") @db.VarChar(36)
  categoryId   String?  @map("category_id") @db.VarChar(36) // Used for linking to Account
  direction    String   @db.VarChar(50) // "inflow", "outflow"
  category     String   @db.VarChar(100)
  amount       Decimal  @db.Decimal(14, 2)
  occurredOn   DateTime @default(now()) @map("occurred_on")
  counterparty String?  @db.VarChar(255)
  note         String?  @db.Text
  source       String   @default("manual") @db.VarChar(50) // "manual", "bank_statement", "receipt_scan"
  createdAt    DateTime @default(now()) @map("created_at")

  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch  Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  account Account? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([companyId])
  @@index([userId, occurredOn(sort: Desc)])
  @@map("transactions")
}

model BalanceItem {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String?  @map("user_id") @db.VarChar(36)
  companyId String?  @map("company_id") @db.VarChar(36)
  side      String   @db.VarChar(50) // "asset", "liability"
  name      String   @db.VarChar(255)
  category  String   @default("Other") @db.VarChar(100)
  amount    Decimal  @db.Decimal(14, 2)
  asOf      DateTime @default(now()) @map("as_of")
  createdAt DateTime @default(now()) @map("created_at")

  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([companyId])
  @@map("balance_items")
}

model SystemSettings {
  id        String   @id @default(uuid()) @db.VarChar(36)
  key       String   @unique @db.VarChar(100)
  value     String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model Page {
  id        String   @id @default(uuid()) @db.VarChar(36)
  slug      String   @unique @db.VarChar(100)
  title     String   @db.VarChar(255)
  content   String   @db.Text
  published Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("pages")
}

model ActivityLog {
  id          String   @id @default(uuid()) @db.VarChar(36)
  userId      String?  @map("user_id") @db.VarChar(36)
  companyId   String?  @map("company_id") @db.VarChar(36)
  action      String   @db.VarChar(100)
  description String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("activity_logs")
}

model PaymentGateway {
  id        String   @id @default(uuid()) @db.VarChar(36)
  provider  String   @unique @db.VarChar(100)
  publicKey String?  @map("public_key") @db.VarChar(255)
  secretKey String?  @map("secret_key") @db.VarChar(255)
  isActive  Boolean  @default(false) @map("is_active")
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("payment_gateways")
}

model Account {
  id             String   @id @default(uuid()) @db.VarChar(36)
  companyId      String   @map("company_id") @db.VarChar(36)
  name           String   @db.VarChar(255)
  code           String?  @db.VarChar(50)
  type           String   @db.VarChar(50) // "ASSET", "LIABILITY", "EQUITY", "REVENUE", "EXPENSE"
  subType        String?  @map("sub_type") @db.VarChar(100)
  parentId       String?  @map("parent_id") @db.VarChar(36)
  openingBalance Decimal  @default(0) @map("opening_balance") @db.Decimal(14, 2)
  isArchived     Boolean  @default(false) @map("is_archived")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  company          Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent           Account?           @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children         Account[]          @relation("AccountHierarchy")
  journalLines     JournalLine[]
  transactions     Transaction[]
  templateLines    TemplateLine[]
  SalesInvoiceLine SalesInvoiceLine[]

  @@index([companyId])
  @@map("accounts")
}

model JournalEntry {
  id          String   @id @default(uuid()) @db.VarChar(36)
  companyId   String   @map("company_id") @db.VarChar(36)
  date        DateTime
  description String   @db.Text
  reference   String?  @db.VarChar(255)
  status      String   @default("POSTED") @db.VarChar(50) // "DRAFT", "PENDING_APPROVAL", "POSTED", "REVERSED"
  templateId  String?  @map("template_id") @db.VarChar(36)
  reversalId  String?  @map("reversal_id") @db.VarChar(36) // If this entry is a reversal of another entry
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company    Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lines      JournalLine[]
  template   JournalTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  reversal   JournalEntry?    @relation("ReversalRelation", fields: [reversalId], references: [id], onDelete: SetNull)
  reversedBy JournalEntry[]   @relation("ReversalRelation")

  @@index([companyId])
  @@index([companyId, date(sort: Desc)])
  @@map("journal_entries")
}

model JournalLine {
  id             String   @id @default(uuid()) @db.VarChar(36)
  journalEntryId String   @map("journal_entry_id") @db.VarChar(36)
  accountId      String   @map("account_id") @db.VarChar(36)
  debit          Decimal  @default(0) @db.Decimal(14, 2)
  credit         Decimal  @default(0) @db.Decimal(14, 2)
  createdAt      DateTime @default(now()) @map("created_at")

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_lines")
}

model JournalTemplate {
  id          String   @id @default(uuid()) @db.VarChar(36)
  companyId   String   @map("company_id") @db.VarChar(36)
  name        String   @db.VarChar(255)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company       Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  entries       JournalEntry[]
  schedules     RecurringSchedule[]
  templateLines TemplateLine[]

  @@index([companyId])
  @@map("journal_templates")
}

model TemplateLine {
  id            String   @id @default(uuid()) @db.VarChar(36)
  templateId    String   @map("template_id") @db.VarChar(36)
  accountId     String   @map("account_id") @db.VarChar(36)
  debitRatio    Decimal  @default(0) @db.Decimal(14, 4) // Ratio or fixed amount
  creditRatio   Decimal  @default(0) @db.Decimal(14, 4)
  isFixedAmount Boolean  @default(false) @map("is_fixed_amount")
  createdAt     DateTime @default(now()) @map("created_at")

  template JournalTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  account  Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@index([accountId])
  @@map("template_lines")
}

model RecurringSchedule {
  id         String    @id @default(uuid()) @db.VarChar(36)
  companyId  String    @map("company_id") @db.VarChar(36)
  templateId String    @map("template_id") @db.VarChar(36)
  frequency  String    @db.VarChar(50) // "DAILY", "WEEKLY", "MONTHLY", "YEARLY"
  startDate  DateTime  @map("start_date")
  endDate    DateTime? @map("end_date")
  lastRun    DateTime? @map("last_run")
  nextRun    DateTime  @map("next_run")
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  template JournalTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([nextRun])
  @@map("recurring_schedules")
}

model Customer {
  id         String   @id @default(uuid()) @db.VarChar(36)
  companyId  String   @map("company_id") @db.VarChar(36)
  name       String   @db.VarChar(255)
  email      String?  @db.VarChar(255)
  phone      String?  @db.VarChar(50)
  address    String?  @db.Text
  currency   String   @default("NGN") @db.VarChar(10)
  isArchived Boolean  @default(false) @map("is_archived")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoices    SalesInvoice[]
  payments    CustomerPayment[]
  creditNotes CreditNote[]

  @@index([companyId])
  @@map("customers")
}

model SalesInvoice {
  id            String   @id @default(uuid()) @db.VarChar(36)
  companyId     String   @map("company_id") @db.VarChar(36)
  customerId    String   @map("customer_id") @db.VarChar(36)
  invoiceNumber String   @map("invoice_number") @db.VarChar(50)
  issueDate     DateTime @map("issue_date")
  dueDate       DateTime @map("due_date")
  status        String   @default("DRAFT") @db.VarChar(50) // DRAFT, SENT, PARTIAL, PAID, OVERDUE, CANCELLED
  subtotal      Decimal  @default(0) @db.Decimal(14, 2)
  taxAmount     Decimal  @default(0) @map("tax_amount") @db.Decimal(14, 2)
  totalAmount   Decimal  @default(0) @map("total_amount") @db.Decimal(14, 2)
  notes         String?  @db.Text
  terms         String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  company     Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer    Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lines       SalesInvoiceLine[]
  payments    PaymentAllocation[]
  creditNotes CreditNoteAllocation[]

  @@index([companyId])
  @@index([customerId])
  @@map("sales_invoices")
}

model SalesInvoiceLine {
  id          String   @id @default(uuid()) @db.VarChar(36)
  invoiceId   String   @map("invoice_id") @db.VarChar(36)
  accountId   String   @map("account_id") @db.VarChar(36) // Revenue Account
  description String   @db.VarChar(255)
  quantity    Decimal  @default(1) @db.Decimal(14, 2)
  unitPrice   Decimal  @default(0) @map("unit_price") @db.Decimal(14, 2)
  amount      Decimal  @default(0) @db.Decimal(14, 2)
  taxRate     Decimal  @default(0) @map("tax_rate") @db.Decimal(5, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  invoice SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  account Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([accountId])
  @@map("sales_invoice_lines")
}

model CustomerPayment {
  id            String   @id @default(uuid()) @db.VarChar(36)
  companyId     String   @map("company_id") @db.VarChar(36)
  customerId    String   @map("customer_id") @db.VarChar(36)
  date          DateTime
  amount        Decimal  @default(0) @db.Decimal(14, 2)
  reference     String?  @db.VarChar(100)
  paymentMethod String   @default("BANK_TRANSFER") @map("payment_method") @db.VarChar(50) // BANK_TRANSFER, CASH, CARD
  status        String   @default("COMPLETED") @db.VarChar(50)
  notes         String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer    Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  allocations PaymentAllocation[]

  @@index([companyId])
  @@index([customerId])
  @@map("customer_payments")
}

model PaymentAllocation {
  id        String   @id @default(uuid()) @db.VarChar(36)
  paymentId String   @map("payment_id") @db.VarChar(36)
  invoiceId String   @map("invoice_id") @db.VarChar(36)
  amount    Decimal  @default(0) @db.Decimal(14, 2)
  createdAt DateTime @default(now()) @map("created_at")

  payment CustomerPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice SalesInvoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([invoiceId])
  @@map("payment_allocations")
}

model CreditNote {
  id               String   @id @default(uuid()) @db.VarChar(36)
  companyId        String   @map("company_id") @db.VarChar(36)
  customerId       String   @map("customer_id") @db.VarChar(36)
  creditNoteNumber String   @map("credit_note_number") @db.VarChar(50)
  date             DateTime
  amount           Decimal  @default(0) @db.Decimal(14, 2)
  status           String   @default("DRAFT") @db.VarChar(50) // DRAFT, ISSUED, APPLIED
  reason           String?  @db.Text
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  company     Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer    Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  allocations CreditNoteAllocation[]

  @@index([companyId])
  @@index([customerId])
  @@map("credit_notes")
}

model CreditNoteAllocation {
  id           String   @id @default(uuid()) @db.VarChar(36)
  creditNoteId String   @map("credit_note_id") @db.VarChar(36)
  invoiceId    String   @map("invoice_id") @db.VarChar(36)
  amount       Decimal  @default(0) @db.Decimal(14, 2)
  createdAt    DateTime @default(now()) @map("created_at")

  creditNote CreditNote   @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  invoice    SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([creditNoteId])
  @@index([invoiceId])
  @@map("credit_note_allocations")
}

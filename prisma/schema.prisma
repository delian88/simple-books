generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String       @id @default(uuid()) @db.VarChar(36)
  email              String       @unique @db.VarChar(255)
  password           String       @db.VarChar(255)
  role               String       @default("Company") @db.VarChar(50) // "Admin" or "Company"
  subscriptionStatus String?      @map("subscription_status") @db.VarChar(50) // "TRIAL", "ACTIVE", "EXPIRED"
  trialEndsAt        DateTime?    @map("trial_ends_at")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  profile            Profile?
  transactions       Transaction[]
  balanceItems       BalanceItem[]
  activityLogs       ActivityLog[]

  @@map("users")
}

model Profile {
  id           String   @id @db.VarChar(36)
  businessName String   @default("My Business") @map("business_name") @db.VarChar(255)
  currency     String   @default("NGN") @db.VarChar(10)
  createdAt    DateTime @default(now()) @map("created_at")

  user         User     @relation(fields: [id], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Transaction {
  id           String   @id @default(uuid()) @db.VarChar(36)
  userId       String   @map("user_id") @db.VarChar(36)
  direction    String   @db.VarChar(50) // "inflow", "outflow"
  category     String   @db.VarChar(100)
  amount       Decimal  @db.Decimal(14, 2)
  occurredOn   DateTime @default(now()) @map("occurred_on")
  counterparty String?  @db.VarChar(255)
  note         String?  @db.Text
  source       String   @default("manual") @db.VarChar(50) // "manual", "bank_statement", "receipt_scan"
  createdAt    DateTime @default(now()) @map("created_at")

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, occurredOn(sort: Desc)])
  @@map("transactions")
}

model BalanceItem {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String   @map("user_id") @db.VarChar(36)
  side      String   @db.VarChar(50) // "asset", "liability"
  name      String   @db.VarChar(255)
  category  String   @default("Other") @db.VarChar(100)
  amount    Decimal  @db.Decimal(14, 2)
  asOf      DateTime @default(now()) @map("as_of")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("balance_items")
}

model SystemSettings {
  id        String   @id @default(uuid()) @db.VarChar(36)
  key       String   @unique @db.VarChar(100)
  value     String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model Page {
  id        String   @id @default(uuid()) @db.VarChar(36)
  slug      String   @unique @db.VarChar(100)
  title     String   @db.VarChar(255)
  content   String   @db.Text
  published Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("pages")
}

model ActivityLog {
  id          String   @id @default(uuid()) @db.VarChar(36)
  userId      String?  @map("user_id") @db.VarChar(36)
  action      String   @db.VarChar(100)
  description String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("activity_logs")
}

model PaymentGateway {
  id          String   @id @default(uuid()) @db.VarChar(36)
  provider    String   @unique @db.VarChar(100) // "budpay", "paystack", "flutterwave", "monnify", "korapay"
  publicKey   String?  @map("public_key") @db.VarChar(255)
  secretKey   String?  @map("secret_key") @db.VarChar(255)
  isActive    Boolean  @default(false) @map("is_active")
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("payment_gateways")
}
